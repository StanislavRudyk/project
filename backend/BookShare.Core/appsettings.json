{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "DatabaseSettings": {
    "ConnectionString": "Host=localhost;Port=5432;Database=bookshare;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "BookShare",
    "Audience": "BookShare.Client",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },

  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "bookshare",
    "SecretKey": "bookshare_password",
    "BucketName": "bookshare",
    "UseSsl": false
  }
}